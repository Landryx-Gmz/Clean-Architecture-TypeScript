{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@domain/*": [
                "src/domain/*"
            ],
            "@application/*": [
                "src/application/*"
            ],
            "@infrastructure/*": [
                "src/infrastructure/*"
            ],
            "@composition/*": [
                "src/composition/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "main.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}